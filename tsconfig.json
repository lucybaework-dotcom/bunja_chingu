{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "noEmit": true,
    "skipLibCheck": true, "isolatedModules": true, "noUnusedLocals": true, "types": ["vitest/globals", "vite/client"]
  },
  "include": ["*.ts", "*.tsx"],
  "exclude": ["vite.config.ts", "node_modules", "dist", "dist-demo"]
}
